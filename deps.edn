{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        com.taoensso/timbre {:mvn/version "6.8.0"}

        ;; hive-addon: the IAddon contract this addon implements. Depending on
        ;; the contract lib rather than on a host namespace is what lets any
        ;; host, hive-mcp or not, mount this jar.
        io.github.hive-agi/hive-addon {:mvn/version "0.3.10"}

        ;; hive-dsl — Result monad, rescue/guard DSL, ADTs
        io.github.hive-agi/hive-dsl {:mvn/version "0.5.21"}

        ;; hive-spi — the lifecycle and memory ports the shutdown hook binds.
        io.github.hive-agi/hive-spi {:mvn/version "0.2.0"}

        metosin/malli {:mvn/version "0.20.1"}

        ;; hive-events — event system for lifecycle.
        ;; Still a git coord: hive-events is not on Clojars yet. Flip to
        ;; {:mvn/version "..."} once it is published, otherwise hive-proximum
        ;; cannot itself be released (a Maven artifact must not depend on a
        ;; git coord — the pom would carry an unresolvable dependency).
        io.github.hive-agi/hive-events
        {:mvn/version "0.5.9"}

        ;; hive-di — typed config (defconfig + env/file/coalesce sources).
        ;; Used by hive-proximum.vec.config/ProximumVecConfig. Pinned to
        ;; the same version as hive-mcp to avoid downstream classpath drift.
        io.github.hive-agi/hive-di {:mvn/version "0.4.8"}

        ;; Datahike — versioned Datalog with bitemporal support
        ;; Matches hive-mcp/hive-knowledge version for classpath compat
        org.replikativ/datahike {:mvn/version "0.8.1788"}

        ;; Proximum — persistent HNSW vector index. Powers the
        ;; hive-proximum.vec.* namespaces (Phase 2 of the storage
        ;; migration). hive-mcp depends on hive-proximum and late-binds
        ;; to hive-proximum.vec.store/create-store via the slot factory.
        org.replikativ/proximum {:mvn/version "0.1.38"}
        org.clojure/data.json {:mvn/version "2.5.2"}}
 :aliases
 {:build {:deps {io.github.hive-agi/hive-build {:mvn/version "0.1.10"}}
          :ns-default hive-build.api}

  :test {:extra-paths ["test"]
         :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                      org.clojure/test.check {:mvn/version "1.1.3"}
                      com.gfredericks/test.chuck
                      {:mvn/version "0.2.15"}
                      io.github.hive-agi/hive-test
                      {:mvn/version "0.3.17"}
                      io.github.hive-agi/hive-schemas
                      {:mvn/version "0.1.29"}}
         ;; Proximum's HNSW vector ops use the JDK incubator vector
         ;; module (jdk.incubator.vector.FloatVector). The module is
         ;; opt-in — without --add-modules it's not on the runtime
         ;; classpath and the `create-index` call throws a
         ;; ClassNotFoundException for FloatVector.
         :jvm-opts ["--add-modules=jdk.incubator.vector"
                    "--enable-native-access=ALL-UNNAMED"]}}}
